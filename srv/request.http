###
GET https://services.odata.org/V4/Northwind/Northwind.svc/Suppliers?$filter=Fax ne null

###
GET https://services.odata.org/V4/Northwind/Northwind.svc/Orders?$select=CustomerID&$filter=RequiredDate ge 1997-01-01T00:00:00Z and RequiredDate le 1998-01-01T00:00:00Z and Freight lt 100


###
GET https://services.odata.org/V4/Northwind/Northwind.svc/Customers?$select=CompanyName,ContactName&$filter=ContactTitle eq 'Owner' and (Country eq 'Mexico' or Country eq 'Sweden' or Country eq 'Germany')

### 1. Count the number of discontinued products
GET https://services.odata.org/V4/Northwind/Northwind.svc/Products/$count?$filter=Discontinued eq true

### 2. Category names and descriptions beginning with 'Co'
GET https://services.odata.org/V4/Northwind/Northwind.svc/Categories?$select=CategoryName,Description&$filter=startswith(CategoryName,'Co')

### 3. Suppliers having 'rue' in address, ordered by company name
GET https://services.odata.org/V4/Northwind/Northwind.svc/Suppliers?$select=CompanyName,City,Country,PostalCode&$filter=contains(Address,'rue')&$orderby=CompanyName asc

### 4. Product ID and total quantity ordered for each product 
GET https://odata.org((ProductID),aggregate(Quantity with sum as TotalQuantity))

### 5. Customer name and address whose orders shipped using Speedy Express
GET https://services.odata.org/V4/Northwind/Northwind.svc/Customers?$select=CompanyName,Address&$filter=Orders/any(o:o/Shipper/CompanyName eq 'Speedy Express')

### 6. Supplier company name, contact name, contact title and region
GET https://services.odata.org/V4/Northwind/Northwind.svc/Suppliers?$select=CompanyName,ContactName,ContactTitle,Region

### 7. Product names that are Condiments
GET https://services.odata.org/V4/Northwind/Northwind.svc/Products?$select=ProductName&$filter=Category/CategoryName eq 'Condiments'

### 8. Customer names having no orders
GET https://services.odata.org/V4/Northwind/Northwind.svc/Customers?$select=CompanyName&$filter=not Orders/any()

### 9. Freight total for each shipper   error
GET https://services.odata.org/V4/Northwind/Northwind.svc/Orders?$apply=groupby((ShipVia),aggregate(Freight with sum as TotalFreight))

### 10. Employee first and last names
GET https://services.odata.org/V4/Northwind/Northwind.svc/Employees?$select=LastName,FirstName

### 11. Products with UnitsInStock + UnitsOnOrder greater than 100   error
GET https://services.odata.org/V4/Northwind/Northwind.svc/Products?$compute=UnitsInStock add UnitsOnOrder as TotalUnits&$select=ProductName,TotalUnits&$filter=TotalUnits gt 100

### 12. Name, address, city and region of employees
GET https://services.odata.org/V4/Northwind/Northwind.svc/Employees?$select=FirstName,LastName,Address,City,Region

### 13. Name, address, city and region of employees living in USA
GET https://services.odata.org/V4/Northwind/Northwind.svc/Employees?$select=FirstName,LastName,Address,City,Region&$filter=Country eq 'USA'

### 14. Employees older than 50 years
GET https://services.odata.org/V4/Northwind/Northwind.svc/Employees?$select=FirstName,LastName,Address,City,Region&$filter=BirthDate lt 1948-01-01T00:00:00Z

### 15. Employees who sold Gravad Lax or Mishi Kobe Niku
GET https://services.odata.org/V4/Northwind/Northwind.svc/Employees?$select=Title,FirstName,LastName&$filter=Orders/any(o:o/Order_Details/any(d:d/Product/ProductName eq 'Gravad Lax' or d/Product/ProductName eq 'Mishi Kobe Niku'))







